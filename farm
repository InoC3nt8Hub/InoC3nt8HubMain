

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Player = Players.LocalPlayer

-- ============================================================
-- CONFIGURATION
-- ============================================================
local ITEM_FOLDER = Workspace:WaitForChild("GameTriggers"):WaitForChild("Items")
local HQ_POINT = Workspace:WaitForChild("HQRespawnPoint")
local LOOP_DELAY = 0.03
local HQ_PAUSE = 0.01
local DROP_INTERVAL = 0.05
local NO_ITEM_RETURN_DELAY = 0.01   -- Wait at HQ if no items found

local FarmRunning = true

-- ============================================================
-- HELPER: Character & Root
-- ============================================================
local function GetRoot()
    local char = Player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local char = Player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

-- ============================================================
-- HELPER: HQ Teleport
-- ============================================================
local function GetHQCFrame()
    if HQ_POINT:IsA("BasePart") then
        return HQ_POINT.CFrame
    elseif HQ_POINT:IsA("Model") then
        return HQ_POINT:GetPivot()
    end
    return nil
end

local function TeleportHQ()
    local root = GetRoot()
    local hqCFrame = GetHQCFrame()
    if root and hqCFrame then
        root.CFrame = hqCFrame + Vector3.new(0, 3, 0)
        return true
    end
    return false
end

-- ============================================================
-- HELPER: Quota & Intermission
-- ============================================================
local function GetCurrentProfit()
    return tonumber(ReplicatedStorage:GetAttribute("CurrentLevelProfit")) or 0
end

local function GetProfitQuota()
    local quota = ReplicatedStorage:GetAttribute("profitQuota")
    if not quota then quota = ReplicatedStorage:GetAttribute("ProfitQuota") end
    return tonumber(quota) or 0
end

local function IsGoalComplete()
    local current = GetCurrentProfit()
    local goal = GetProfitQuota()
    return goal > 0 and current >= goal
end

local function IsQuotaIndicatorActive()
    local mainHud = Player:FindFirstChild("PlayerGui") and Player.PlayerGui:FindFirstChild("MainHud")
    if not mainHud then return false end
    if mainHud:GetAttribute("VisuallyQuotaMet") == true then return true end
    for _, obj in ipairs(mainHud:GetDescendants()) do
        if obj:GetAttribute("VisuallyQuotaMet") == true then return true end
    end
    return false
end

local function IsIntermission()
    local containers = { ReplicatedStorage, Workspace, Player, Player:FindFirstChild("PlayerGui") }
    for _, container in ipairs(containers) do
        if container then
            for name, value in pairs(container:GetAttributes()) do
                if string.lower(name):find("intermission", 1, true) and value == true then
                    return true
                end
            end
        end
    end
    return false
end

-- ============================================================
-- HELPER: Inventory & Weight
-- ============================================================
local function GetInventory()
    local inventories = ReplicatedStorage:FindFirstChild("Inventories")
    if not inventories then return nil end
    return inventories:FindFirstChild(tostring(Player.UserId))
end

local function GetMaxSlots()
    return (Player:GetAttribute("HasExtraInventorySlot") == true) and 5 or 4
end

local function IsInventoryFull()
    if Player:GetAttribute("HandsFull") == true then return true end
    local inv = GetInventory()
    if not inv then return false end
    return #inv:GetChildren() >= GetMaxSlots()
end

local function GetInventoryWeight()
    local inv = GetInventory()
    if not inv then return 0 end
    local total = 0
    for _, item in ipairs(inv:GetChildren()) do
        total = total + (tonumber(item:GetAttribute("weight")) or 0)
    end
    return total
end

local function GetMaxWeight()
    local names = { "MaxWeight", "maxWeight", "WeightLimit", "weightLimit", "CarryWeight", "MaxCarryWeight" }
    for _, name in ipairs(names) do
        local val = tonumber(Player:GetAttribute(name))
        if val then return val end
        val = tonumber(ReplicatedStorage:GetAttribute(name))
        if val then return val end
    end
    return nil
end

local function IsWeightFull()
    local maxWeight = GetMaxWeight()
    if not maxWeight or maxWeight <= 0 then return false end
    return GetInventoryWeight() >= maxWeight
end

-- ============================================================
-- HELPER: Item Info & Prompt Setup
-- ============================================================
local function GetItemPrice(item)
    return tonumber(item:GetAttribute("price")) or 0
end

local function GetItemWeight(item)
    return tonumber(item:GetAttribute("weight")) or 0
end

local function IsValidItem(item)
    if not item or not item.Parent then return false end
    return item:IsA("Tool") or item:IsA("Model") or item:IsA("BasePart")
end

local function SetupPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    pcall(function()
        prompt.MaxActivationDistance = 20
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.KeyboardKeyCode = Enum.KeyCode.E
    end)
end

local function FindPrompt(item)
    if not item then return nil end
    if item:IsA("ProximityPrompt") then
        SetupPrompt(item)
        return item
    end
    local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then SetupPrompt(prompt) end
    return prompt
end

local function GetItemPart(item)
    if not item then return nil end
    if item:IsA("BasePart") then return item end
    if item:IsA("Tool") then
        return item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart", true)
    end
    if item:IsA("Model") then
        return item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart", true)
    end
    return item:FindFirstChildWhichIsA("BasePart", true)
end

-- ============================================================
-- CORE: Instant Pickup (Teleport ON TOP of item)
-- ============================================================
local function InstantPickup(item)
    if not IsValidItem(item) then return false end

    local root = GetRoot()
    local part = GetItemPart(item)
    local prompt = FindPrompt(item)

    if not root or not part or not prompt then return false end

    local partPos = part.Position
    local heightOffset = (part.Size.Y / 2) + 1
    local targetPos = partPos + Vector3.new(0, heightOffset, 0)

    pcall(function()
        root.CFrame = CFrame.new(targetPos)
    end)

    pcall(function()
        fireproximityprompt(prompt, 0)
    end)

    return true
end

-- ============================================================
-- CORE: Find Highest‑Value Item (PRICE ONLY)
-- ============================================================
local function GetBestItem()
    local bestItem = nil
    local bestPrice = -math.huge

    for _, item in ipairs(ITEM_FOLDER:GetChildren()) do
        if IsValidItem(item) then
            local prompt = FindPrompt(item)
            if prompt then
                local price = GetItemPrice(item)
                -- 🔥 ONLY compare by price, ignore weight completely
                if price > bestPrice then
                    bestPrice = price
                    bestItem = item
                end
            end
        end
    end
    return bestItem
end

-- ============================================================
-- CORE: Drop Inventory at HQ
-- ============================================================
local DropRemote = ReplicatedStorage:FindFirstChild("RemoteEvents")
                    and ReplicatedStorage.RemoteEvents:FindFirstChild("playerDropItemEvent")

local function DropAllItems()
    local inventory = GetInventory()
    if not inventory or not DropRemote then return end

    local items = inventory:GetChildren()
    for _, item in ipairs(items) do
        if item and item.Parent == inventory then
            pcall(function()
                DropRemote:FireServer(item)
            end)
            task.wait(DROP_INTERVAL)
        end
    end
end

-- ============================================================
-- STATE: Handle Full Inventory / Weight
-- ============================================================
local function HandleFullInventory()
    TeleportHQ()
    task.wait(HQ_PAUSE)
    DropAllItems()
    task.wait(0.5)
    return true
end

-- ============================================================
-- STATE: Check if we should return to HQ
-- ============================================================
local function ShouldReturnHQ()
    if IsGoalComplete() then return true, "Goal Complete" end
    if IsQuotaIndicatorActive() then return true, "Quota Reached" end
    if IsIntermission() then return true, "Intermission" end
    if IsInventoryFull() then return true, "Inventory Full" end
    if IsWeightFull() then return true, "Weight Full" end
    return false, nil
end

-- ============================================================
-- MAIN FARM LOOP
-- ============================================================
local function StartAutoFarm()
    print("[AutoFarm] Started - Prioritizing HIGHEST PRICE only!")

    while FarmRunning do
        local root = GetRoot()
        if not root then
            task.wait(0.2)
            continue
        end

        -- 1️⃣ Check return conditions (Inventory/Weight full, Quota, Intermission)
        local shouldReturn, reason = ShouldReturnHQ()
        if shouldReturn then
            print("[AutoFarm] Returning to HQ:", reason)
            TeleportHQ()

            if reason == "Goal Complete" or reason == "Quota Reached" then
                repeat
                    task.wait(0.25)
                until not FarmRunning or (not IsGoalComplete() and not IsQuotaIndicatorActive())
                continue
            end

            if reason == "Intermission" then
                repeat
                    task.wait(0.25)
                until not FarmRunning or not IsIntermission()
                continue
            end

            if reason == "Inventory Full" or reason == "Weight Full" then
                HandleFullInventory()  -- 🟢 Drop all items at HQ
                continue
            end
        end

        -- 2️⃣ Find the item with the HIGHEST PRICE (Weight is ignored here)
        local item = GetBestItem()
        if item then
            local price = GetItemPrice(item)
            local weight = GetItemWeight(item)
            print(string.format("[AutoFarm] Picking BEST PRICE: %s (Price: %d, Weight: %d)", item.Name, price, weight))
            InstantPickup(item)
            task.wait(LOOP_DELAY)
        else
            -- 3️⃣ If NO items exist, wait at HQ for respawns
            print("[AutoFarm] No items found. Waiting at HQ...")
            TeleportHQ()
            task.wait(NO_ITEM_RETURN_DELAY)
        end
    end

    print("[AutoFarm] Stopped")
end

