--------------------------------------------------
-- PLACE ID SCRIPT LOADER
--------------------------------------------------

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local SupportedGames = {

    [11765763028] = "https://raw.githubusercontent.com/InoC3nt8Hub/InoC3nt8HubScripts/refs/heads/main/ReignFallScriptFixedNewUpdate.lua.txt",

    [113254082779663] = "https://raw.githubusercontent.com/InoC3nt8Hub/InoC3nt8HubScripts/refs/heads/main/SomTum_AnomalyScript.lua.txt",

    [74716719697996] = "https://raw.githubusercontent.com/InoC3nt8Hub/InoC3nt8HubScripts/refs/heads/main/SurviveVerityInArea51.lua.txt",

    [107186729022278] = "https://raw.githubusercontent.com/InoC3nt8Hub/InoC3nt8HubScripts/refs/heads/main/KillZombiesInArea51.lua.txt",

      [87468080405188] = "https://raw.githubusercontent.com/InoC3nt8Hub/InoC3nt8HubScripts/refs/heads/main/HomeAloneAnomaly.lua.txt",

    [82554996468034] = "https://raw.githubusercontent.com/InoC3nt8Hub/InoC3nt8HubScripts/refs/heads/main/%2B1%20Pickaxe%20Swing%20Escape.lua.txt",

  [115681808123944] = "https://raw.githubusercontent.com/InoC3nt8Hub/InoC3nt8HubScripts/refs/heads/main/ThrowACoinScript.lua",

  [135741623561779] = "https://raw.githubusercontent.com/InoC3nt8Hub/InoC3nt8HubScripts/refs/heads/main/BackroomsCompanyFixedNewUpdate.lua.txt",

[111902511656171] = "https://raw.githubusercontent.com/InoC3nt8Hub/InoC3nt8HubScripts/refs/heads/main/WardenSurvivalEscape.lua.txt",

     [17457039279] = "https://raw.githubusercontent.com/InoC3nt8Hub/InoC3nt8HubScripts/refs/heads/main/DarkestHoursScriptBeta.lua.txt",

  [18794863104] = "https://raw.githubusercontent.com/InoC3nt8Hub/InoC3nt8HubScripts/refs/heads/main/DemonologyScriptBeta.lua.txt",


}


--------------------------------------------------
-- PLACE CHECK
--------------------------------------------------

local PlaceId = game.PlaceId
local ScriptURL = SupportedGames[PlaceId]


if not ScriptURL then
    
    warn("Unsupported Place ID:", PlaceId)

    if LocalPlayer then
        LocalPlayer:Kick(
            "This game is not supported.\nPlace ID: "..PlaceId
        )
    end

    return
end


--------------------------------------------------
-- LOAD SCRIPT
--------------------------------------------------

local Success, Response = pcall(function()

    local Source = game:HttpGet(ScriptURL)

    local LoadedFunction = loadstring(Source)

    if LoadedFunction then
        LoadedFunction()
    end

end)


if not Success then
    
    warn("Loader Error:", Response)

    if LocalPlayer then
        LocalPlayer:Kick(
            "Script failed to load."
        )
    end

end
